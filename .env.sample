# Copy to .env and set unique local-only passwords before starting.
WP_PORT=8080
ADMINER_PORT=8088

DB_NAME=wordpress
DB_USER=wordpress
DB_PASSWORD=
DB_ROOT_PASSWORD=

# Match the target project's runtime; these are development defaults.
WP_IMAGE=wordpress:php8.5-apache
WP_CLI_IMAGE=wordpress:cli-php8.5
DB_IMAGE=mariadb:11
ADMINER_IMAGE=adminer:5
